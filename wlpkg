#!/bin/bash
# wlpkg - Wordlang Package Manager
# Usage: wlpkg <command> [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGES_DIR="$SCRIPT_DIR/packages"
STD_DIR="$SCRIPT_DIR/lib/std"
TEMPLATE_DIR="$SCRIPT_DIR/templates"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print banner
banner() {
    echo -e "${BLUE}"
    echo "╔══════════════════════════════════════╗"
    echo "║     wlpkg - Wordlang Package Manager ║"
    echo "╚══════════════════════════════════════╝"
    echo -e "${NC}"
}

# Help command
show_help() {
    banner
    echo "Commands:"
    echo "  list                    List all installed packages"
    echo "  list std                List standard library modules"
    echo "  list core               List core (C) libraries"
    echo "  install <name>          Install a package from packages/"
    echo "  remove <name>           Remove an installed package"
    echo "  create <name>           Create a new package from template"
    echo "  info <name>             Show package information"
    echo "  init                    Initialize packages directory"
    echo "  help                    Show this help message"
    echo ""
    echo "Examples:"
    echo "  wlpkg list              # List installed packages"
    echo "  wlpkg create mylib      # Create new package 'mylib'"
    echo "  wlpkg install mylib     # Install from packages/mylib.wl"
    echo "  wlpkg remove mylib      # Remove package"
    echo ""
}

# Initialize packages directory
init_packages() {
    mkdir -p "$PACKAGES_DIR"
    mkdir -p "$TEMPLATE_DIR"
    echo -e "${GREEN}✓ Initialized packages directory${NC}"
}

# List installed packages
list_packages() {
    echo -e "${BLUE}Installed Packages:${NC}"
    echo "==================="
    if [ -d "$PACKAGES_DIR" ] && [ "$(ls -A $PACKAGES_DIR 2>/dev/null)" ]; then
        for pkg in "$PACKAGES_DIR"/*.wl; do
            if [ -f "$pkg" ]; then
                name=$(basename "$pkg" .wl)
                # Get first comment line as description
                desc=$(head -n 1 "$pkg" | grep "^#" | sed 's/^# *//')
                if [ -z "$desc" ]; then
                    desc="No description"
                fi
                echo -e "  ${GREEN}$name${NC} - $desc"
            fi
        done
    else
        echo "  (no packages installed)"
    fi
    echo ""
}

# List standard library
list_std() {
    echo -e "${BLUE}Standard Library Modules:${NC}"
    echo "========================="
    if [ -d "$STD_DIR" ]; then
        for mod in "$STD_DIR"/*.wl; do
            if [ -f "$mod" ]; then
                name=$(basename "$mod" .wl)
                desc=$(head -n 1 "$mod" | grep "^#" | sed 's/^# *//')
                if [ -z "$desc" ]; then
                    desc="No description"
                fi
                echo -e "  ${GREEN}$name${NC} - $desc"
            fi
        done
    fi
    echo ""
}

# List core libraries
list_core() {
    echo -e "${BLUE}Core Libraries (C):${NC}"
    echo "===================="
    echo -e "  ${GREEN}math${NC} - abs, min, max, sqrt, random, gcd, lcm, factorial"
    echo -e "  ${GREEN}time${NC} - now, hour, minute, second, day, month, year, weekday"
    echo -e "  ${GREEN}string${NC} - upper, lower, trim, contains, replace, reverse"
    echo ""
    echo "(Core libraries are built-in and always available)"
    echo ""
}

# Create new package from template
create_package() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Package name required${NC}"
        echo "Usage: wlpkg create <name>"
        exit 1
    fi
    
    # Sanitize name
    name=$(echo "$name" | tr -cd 'a-zA-Z0-9_')
    
    if [ -f "$PACKAGES_DIR/$name.wl" ]; then
        echo -e "${RED}Error: Package '$name' already exists${NC}"
        exit 1
    fi
    
    mkdir -p "$PACKAGES_DIR"
    
    cat > "$PACKAGES_DIR/$name.wl" << EOF
# $name - Wordlang Package
# Author: $(whoami)
# Date: $(date +%Y-%m-%d)
# Description: Add your description here
#
# Usage:
#   import "$name"
#   call your_function arg1 arg2

# ============================================
# Package: $name
# ============================================

# Example function - replace with your own
define ${name}_hello do
    print "Hello from $name!"
end

# Example function with parameters
define ${name}_greet with name do
    print concat "Hello, " name "!"
end

# Add your functions below...

EOF

    echo -e "${GREEN}✓ Created package: $PACKAGES_DIR/$name.wl${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Edit the file to add your functions"
    echo "  2. Import in your program with: import \"$name\""
    echo ""
}

# Show package info
show_info() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    # Check packages dir
    if [ -f "$PACKAGES_DIR/$name.wl" ]; then
        pkg="$PACKAGES_DIR/$name.wl"
    elif [ -f "$STD_DIR/$name.wl" ]; then
        pkg="$STD_DIR/$name.wl"
    else
        echo -e "${RED}Error: Package '$name' not found${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}Package: $name${NC}"
    echo "===================="
    echo "Path: $pkg"
    echo ""
    
    # Show description (first comment block)
    echo "Description:"
    head -n 20 "$pkg" | grep "^#" | sed 's/^# */  /'
    echo ""
    
    # Count functions
    funcs=$(grep -c "^define " "$pkg" || echo "0")
    echo "Functions defined: $funcs"
    
    # List functions
    echo ""
    echo "Functions:"
    grep "^define " "$pkg" | sed 's/define /  - /' | sed 's/ with.*//' | sed 's/ do$//'
    echo ""
}

# Install package (copy to lib location or validate)
install_package() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    # Check if already installed
    if [ -f "$PACKAGES_DIR/$name.wl" ]; then
        echo -e "${YELLOW}Package '$name' is already installed${NC}"
        exit 0
    fi
    
    # Check if it's a file path
    if [ -f "$name" ]; then
        cp "$name" "$PACKAGES_DIR/"
        echo -e "${GREEN}✓ Installed package from file: $name${NC}"
        exit 0
    fi
    
    # Check if .wl file exists
    if [ -f "$name.wl" ]; then
        cp "$name.wl" "$PACKAGES_DIR/"
        echo -e "${GREEN}✓ Installed package: $name${NC}"
        exit 0
    fi
    
    echo -e "${RED}Error: Package '$name' not found${NC}"
    echo "To create a new package: wlpkg create $name"
    exit 1
}

# Remove package
remove_package() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    if [ -f "$PACKAGES_DIR/$name.wl" ]; then
        rm "$PACKAGES_DIR/$name.wl"
        echo -e "${GREEN}✓ Removed package: $name${NC}"
    else
        echo -e "${RED}Error: Package '$name' not found in packages directory${NC}"
        exit 1
    fi
}

# Main command handling
case "$1" in
    list)
        banner
        case "$2" in
            std) list_std ;;
            core) list_core ;;
            *)
                list_packages
                list_std
                list_core
                ;;
        esac
        ;;
    install)
        install_package "$2"
        ;;
    remove|uninstall)
        remove_package "$2"
        ;;
    create|new)
        create_package "$2"
        ;;
    info)
        show_info "$2"
        ;;
    init)
        init_packages
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'wlpkg help' for usage"
        exit 1
        ;;
esac

